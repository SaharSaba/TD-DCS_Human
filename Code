h7 = plot(t_shift, KH_LG_plot, 'Color',col_KH, 'LineStyle',line_style_KH, 'LineWidth',3, 'Marker','.', 'MarkerSize',20);

% Plot Coma - TBI side LG (Dash-dot Line)
h8 = plot(t_shift, K_LG_plot, 'Color',col_KT, 'LineStyle',line_style_KT, 'LineWidth',3, 'Marker','.', 'MarkerSize',20);


title('(b) Late Gate', 'FontWeight', 'bold', FontSize= 20);
